{
  "version": 2,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://sheba-technology.onrender.com/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://sheba-technology.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://sheba-technology.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
