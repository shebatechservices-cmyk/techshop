{
  "name": "sheba-technology",
  "version": "16.9.26",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build --prefix frontend && rm -rf ./dist && cp -r frontend/dist ./dist",
    "dev:backend": "node server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "jest --runInBand",
    "seed:expense-categories": "node scripts/seedExpenseCategories.js"
  },
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "@prisma/client": "^6.4.1",
    "concurrently": "^10.0.5",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.3.0",
    "pg": "^8.13.3"
  }
}
