model sms_logs {
  id              Int       @id @default(autoincrement())
  trigger_key     String?   @db.VarChar(100)
  recipient_phone String    @db.VarChar(50)
  recipient_name  String?   @db.VarChar(150)
  message_content String
  sms_count       Int?      @default(1)
  provider        String?   @default("greenweb") @db.VarChar(50)
  gateway_msg_id  String?   @db.VarChar(100)
  status          String?   @default("DELIVERED") @db.VarChar(50)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
}

model sms_trigger_settings {
  id               Int       @id @default(autoincrement())
  trigger_key      String    @unique @db.VarChar(100)
  trigger_name     String    @db.VarChar(150)
  category         String?   @default("Sales") @db.VarChar(50)
  recipient_type   String?   @default("Customer") @db.VarChar(50)
  is_enabled       Boolean?  @default(true)
  template_bn      String
  available_tokens String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
}

model system_backup_logs {
  id          Int       @id @default(autoincrement())
  backup_name String    @db.VarChar(200)
  backup_type String?   @default("SQL Dump") @db.VarChar(50)
  file_size   String?   @default("14.2 MB") @db.VarChar(50)
  status      String?   @default("SUCCESS") @db.VarChar(50)
  created_by  String?   @default("System Admin") @db.VarChar(100)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model trash_records {
  id           Int       @id @default(autoincrement())
  table_name   String    @db.VarChar(50)
  record_id    Int
  record_data  Json
  deleted_by   Int?
  deleted_at   DateTime? @default(now()) @db.Timestamp(6)
  record_title String?   @db.VarChar(255)
  users        users?    @relation(fields: [deleted_by], references: [id], onUpdate: NoAction)
}

model vendor_license_cache {
  id                  Int       @id @default(autoincrement())
  license_key         String    @db.VarChar(150)
  hardware_id         String?   @db.VarChar(100)
  domain_name         String?   @db.VarChar(150)
  status              String?   @default("active") @db.VarChar(50)
  license_expiry      DateTime? @db.Timestamp(6)
  hosting_expiry      DateTime? @db.Timestamp(6)
  domain_expiry       DateTime? @db.Timestamp(6)
  latest_version      String?   @default("16.9.26") @db.VarChar(50)
  vendor_message      String?
  last_sync_at        DateTime? @default(now()) @db.Timestamp(6)
  offline_grace_until DateTime? @db.Timestamp(6)
  cache_signature     String?   @db.VarChar(255)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  student_quota       Int?      @default(500)
  client_app_id       String?   @db.VarChar(100)
}

model register_shifts {
  id                    Int       @id @default(autoincrement())
  branch_id             Int?      @default(1)
  opened_at             DateTime? @default(now()) @db.Timestamp(6)
  closed_at             DateTime? @db.Timestamp(6)
  opened_by             Int?
  opened_by_name        String?   @db.VarChar(150)
  closed_by             Int?
  closed_by_name        String?   @db.VarChar(150)
  opening_balance       Decimal?  @default(0.00) @db.Decimal(14, 2)
  total_cash_sales      Decimal?  @default(0.00) @db.Decimal(14, 2)
  total_due_collections Decimal?  @default(0.00) @db.Decimal(14, 2)
  total_cash_expenses   Decimal?  @default(0.00) @db.Decimal(14, 2)
  expected_cash_balance Decimal?  @default(0.00) @db.Decimal(14, 2)
  actual_cash_counted   Decimal?  @default(0.00) @db.Decimal(14, 2)
  variance_amount       Decimal?  @default(0.00) @db.Decimal(14, 2)
  denominations         Json?     @default("{}")
  status                String?   @default("open") @db.VarChar(50)
  notes                 String?
  is_locked             Boolean?  @default(false)
  sms_alert_sent        Boolean?  @default(false)
  sms_details           Json?     @default("{}")
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
}

model sms_providers {
  id                    Int       @id @default(autoincrement())
  provider_name         String    @db.VarChar(100)
  provider_code         String    @db.VarChar(50)
  api_url               String
  http_method           String?   @default("GET") @db.VarChar(10)
  auth_type             String?   @default("param") @db.VarChar(20)
  api_key               String?   @default("")
  api_secret            String?   @default("")
  sender_id             String?   @default("") @db.VarChar(50)
  param_phone_key       String?   @default("to") @db.VarChar(50)
  param_message_key     String?   @default("message") @db.VarChar(50)
  param_sender_key      String?   @default("sender_id") @db.VarChar(50)
  param_api_key         String?   @default("token") @db.VarChar(50)
  extra_params          Json?     @default("{}")
  balance_endpoint      String?   @default("")
  balance_response_path String?   @default("") @db.VarChar(100)
  is_active             Boolean?  @default(false)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
}
