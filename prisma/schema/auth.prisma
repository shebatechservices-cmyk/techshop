model audit_logs {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  action     String    @db.VarChar(100)
  table_name String?   @db.VarChar(50)
  record_id  Int?
  old_data   Json?
  new_data   Json?
  ip_address String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  severity   String?   @default("INFO") @db.VarChar(20)
  device_id  String?   @db.VarChar(100)
}

model device_sessions {
  id          Int       @id @default(autoincrement())
  device_id   String    @unique @db.VarChar(100)
  device_type String    @db.VarChar(20)
  device_name String    @db.VarChar(200)
  ip_address  String?   @db.VarChar(100)
  user_agent  String?
  last_active DateTime? @default(now()) @db.Timestamp(6)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model ip_rules {
  id               Int       @id @default(autoincrement())
  ip_address       String    @unique @db.VarChar(50)
  rule_type        String    @default("block") @db.VarChar(20)
  reason           String?   @db.VarChar(255)
  blocked_attempts Int?      @default(0)
  created_by       Int?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users?    @relation(fields: [created_by], references: [id], onUpdate: NoAction)
}

model password_reset_requests {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  user_name     String?   @db.VarChar(200)
  identifier    String    @db.VarChar(200)
  user_type     String    @db.VarChar(50)
  target_role   String    @db.VarChar(50)
  contact_phone String?   @db.VarChar(50)
  shop_name     String?   @db.VarChar(200)
  reason        String?
  status        String?   @default("pending") @db.VarChar(50)
  temp_password String?   @db.VarChar(100)
  resolved_by   String?   @db.VarChar(100)
  resolved_at   DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([target_role, status], map: "idx_reset_req_target_status")
}

model permissions {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  module_name      String?            @db.VarChar(100)
  code             String?            @unique @db.VarChar(100)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  permissions      Json?              @default("[]")
  description      String?
  role_permissions role_permissions[]
  users            users[]
}

model security_settings {
  id            Int       @id @default(autoincrement())
  setting_key   String    @unique @db.VarChar(100)
  setting_value String?
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model trusted_devices {
  id            Int       @id @default(autoincrement())
  device_id     String    @unique @db.VarChar(100)
  device_name   String    @db.VarChar(150)
  user_id       Int?
  device_type   String?   @default("desktop") @db.VarChar(50)
  browser_info  String?   @db.VarChar(255)
  ip_address    String?   @db.VarChar(50)
  is_authorized Boolean?  @default(true)
  last_active   DateTime? @default(now()) @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

enum Role {
  ADMIN
  STAFF
  TECHNICIAN
}

model users {
  id                                                           Int                       @id @default(autoincrement())
  role_id                                                      Int?
  role                                                         Role                      @default(STAFF)
  name                                                         String                    @db.VarChar(100)
  phone                                                        String?                   @unique @db.VarChar(50)
  email                                                        String?                   @unique @db.VarChar(100)
  password_hash                                                String                    @db.VarChar(255)
  is_active                                                    Boolean?                  @default(true)
  last_login                                                   DateTime?                 @db.Timestamp(6)
  created_at                                                   DateTime?                 @default(now()) @db.Timestamp(6)
  deleted_at                                                   DateTime?                 @db.Timestamp(6)
  device_id                                                    String?                   @db.VarChar(100)
  allowed_ip                                                   String?                   @db.VarChar(50)
  is_locked                                                    Boolean?                  @default(false)
  failed_login_count                                           Int?                      @default(0)
  role_name                                                    String?                   @db.VarChar(50)
  deleted_by                                                   Int?
  updated_at                                                   DateTime?                 @default(now()) @db.Timestamp(6)
  current_session_token                                        String?                   @db.VarChar(255)
  session_last_active                                          DateTime?                 @default(now()) @db.Timestamp(6)
  browser_fingerprint                                          String?                   @db.VarChar(255)
  approval_status                                              String?                   @default("approved") @db.VarChar(50)
  wallet_balance                                               Decimal?                  @default(0) @db.Decimal(14, 2)
  designation                                                  String?                   @db.VarChar(100)
  salary                                                       Decimal?                  @default(0) @db.Decimal(14, 2)
  address                                                      String?                   @db.Text
  emergency_contact                                            String?                   @db.VarChar(50)
  joining_date                                                 DateTime?                 @default(now()) @db.Timestamp(6)
  notes                                                        String?                   @db.Text
  expenses                                                     expenses[]
  ip_rules                                                     ip_rules[]
  password_reset_requests                                      password_reset_requests[]
  sales_invoices                                               sales_invoices[]
  service_projects_service_projects_assigned_technicianTousers service_projects[]        @relation("service_projects_assigned_technicianTousers")
  service_projects_service_projects_confirmed_byTousers        service_projects[]        @relation("service_projects_confirmed_byTousers")
  trash_records                                                trash_records[]
  trusted_devices                                              trusted_devices[]
  roles                                                        roles?                    @relation(fields: [role_id], references: [id], onUpdate: NoAction)
}
