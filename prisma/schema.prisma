generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tender {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(100)
  createdAt        DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  accounts         Account[]
  payment_accounts payment_accounts[]

  @@map("tenders")
}

model Account {
  id             Int       @id @default(autoincrement())
  tenderId       Int?      @map("tender_id")
  accountName    String    @map("account_name") @db.VarChar(200)
  location       String?   @map("location") @db.VarChar(255)
  openingBalance Decimal?  @default(0.00) @map("opening_balance") @db.Decimal(14, 2)
  currentBalance Decimal?  @default(0.00) @map("current_balance") @db.Decimal(14, 2)
  referenceId    String?   @map("reference_id") @db.VarChar(120)
  createdBy      String?   @map("created_by") @db.VarChar(150)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  tender         Tender?   @relation(fields: [tenderId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("accounts")
}

model account_transactions {
  id               Int              @id @default(autoincrement())
  account_id       Int
  type             String           @db.VarChar(20)
  amount           Decimal          @db.Decimal(14, 2)
  reference        String?          @db.VarChar(120)
  note             String?
  created_at       DateTime?        @default(now()) @db.Timestamp(6)
  transaction_id   String?          @db.VarChar(120)
  transaction_type String?          @db.VarChar(20)
  balance_after    Decimal?         @db.Decimal(14, 2)
  source_type      String?          @db.VarChar(50)
  source_id        String?          @db.VarChar(100)
  created_by       String?          @db.VarChar(100)
  payment_accounts payment_accounts @relation(fields: [account_id], references: [id], onUpdate: NoAction)

  @@index([account_id], map: "idx_account_transactions_account_id")
  @@index([created_at(sort: Desc)], map: "idx_account_transactions_created_at")
  @@index([type], map: "idx_account_transactions_type")
}

model audit_logs {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  action     String    @db.VarChar(100)
  table_name String?   @db.VarChar(50)
  record_id  Int?
  old_data   Json?
  new_data   Json?
  ip_address String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  severity   String?   @default("INFO") @db.VarChar(20)
  device_id  String?   @db.VarChar(100)
}

model brands {
  id              Int             @id @default(autoincrement())
  name            String          @unique @db.VarChar(100)
  deleted_at      DateTime?       @db.Timestamp(6)
  deleted_by      Int?
  sub_category_id Int?
  models          models[]
  product_names   product_names[]
  products        products[]
  series          series[]
}

model business_profiles {
  id             Int       @id @default(autoincrement())
  business_name  String    @db.VarChar(150)
  tagline        String?   @db.VarChar(200)
  phone          String    @db.VarChar(50)
  email          String?   @db.VarChar(100)
  address        String?
  logo_url       String?   @db.VarChar(255)
  currency       String?   @default("BDT") @db.VarChar(10)
  vat_percentage Decimal?  @default(0) @db.Decimal(5, 2)
  invoice_terms  String?
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
}

model categories {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.VarChar(100)
  deleted_at     DateTime?        @db.Timestamp(6)
  deleted_by     Int?
  models         models[]
  product_names  product_names[]
  products       products[]
  sub_categories sub_categories[]
}

model customers {
  id                 Int                @id @default(autoincrement())
  name               String             @db.VarChar(150)
  phone              String             @unique @db.VarChar(50)
  email              String?            @db.VarChar(100)
  address            String?
  customer_type      String?            @default("retail") @db.VarChar(30)
  receivable_balance Decimal            @default(0) @db.Decimal(14, 2)
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  user_role          String?            @default("regular") @db.VarChar(30)
  deleted_at         DateTime?          @db.Timestamp(6)
  loyalty_points     Decimal?           @default(0.00) @db.Decimal(10, 2)
  deleted_by         Int?
  wallet_balance     Decimal?           @default(0) @db.Decimal(14, 2)
  updated_at         DateTime?          @default(now()) @db.Timestamp(6)
  customer_group     String?            @db.VarChar(30)
  product_returns    product_returns[]
  sales_invoices     sales_invoices[]
  sales_quotations   sales_quotations[]
  service_projects   service_projects[]
  warranty_claims    warranty_claims[]

  @@index([name], map: "idx_customers_name")
  @@index([phone], map: "idx_customers_phone")
}

model daily_summaries {
  id              Int       @id @default(autoincrement())
  summary_date    DateTime  @unique @db.Date
  total_sales     Decimal?  @default(0) @db.Decimal(14, 2)
  total_purchases Decimal?  @default(0) @db.Decimal(14, 2)
  total_expenses  Decimal?  @default(0) @db.Decimal(14, 2)
  net_profit      Decimal?  @default(0) @db.Decimal(14, 2)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
}

model damaged_products {
  id          Int       @id @default(autoincrement())
  product_id  Int?
  quantity    Int
  note        String?
  recorded_at DateTime? @default(now()) @db.Timestamp(6)
  products    products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model device_sessions {
  id          Int       @id @default(autoincrement())
  device_id   String    @unique @db.VarChar(100)
  device_type String    @db.VarChar(20)
  device_name String    @db.VarChar(200)
  ip_address  String?   @db.VarChar(100)
  user_agent  String?
  last_active DateTime? @default(now()) @db.Timestamp(6)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model ecommerce_order_items {
  id               Int              @id @default(autoincrement())
  order_id         Int
  product_id       Int
  quantity         Int
  unit_price       Decimal          @db.Decimal(14, 2)
  ecommerce_orders ecommerce_orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         products         @relation(fields: [product_id], references: [id], onUpdate: NoAction)
}

model ecommerce_orders {
  id                    Int                     @id @default(autoincrement())
  order_number          String                  @unique @db.VarChar(30)
  customer_name         String                  @db.VarChar(100)
  customer_phone        String                  @db.VarChar(50)
  shipping_address      String
  delivery_charge       Decimal?                @default(0) @db.Decimal(10, 2)
  total_amount          Decimal                 @db.Decimal(14, 2)
  payment_status        String?                 @default("unpaid") @db.VarChar(20)
  order_status          String?                 @default("processing") @db.VarChar(30)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  order_no              String?                 @db.VarChar(50)
  courier_name          String?                 @db.VarChar(100)
  tracking_code         String?                 @db.VarChar(100)
  customer_notes        String?
  payment_method        String?                 @default("cod") @db.VarChar(50)
  deleted_at            DateTime?               @db.Timestamp(6)
  deleted_by            Int?
  ecommerce_order_items ecommerce_order_items[]
}

model expense_categories {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  description String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  expenses    expenses[]
}

model expenses {
  id                 Int                 @id @default(autoincrement())
  category_id        Int?
  account_id         Int?
  amount             Decimal             @db.Decimal(14, 2)
  expense_date       DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  reference_no       String?             @db.VarChar(100)
  note               String?
  created_by         Int?
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  voucher_no         String?             @db.VarChar(100)
  category_name      String?             @db.VarChar(150)
  account_name       String?             @db.VarChar(150)
  payee_name         String?             @db.VarChar(150)
  deleted_at         DateTime?           @db.Timestamp(6)
  deleted_by         Int?
  payment_accounts   payment_accounts?   @relation(fields: [account_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  expense_categories expense_categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  users              users?              @relation(fields: [created_by], references: [id], onUpdate: NoAction)
}

model financial_accounts {
  id             Int            @id @default(autoincrement())
  account_name   String         @db.VarChar(100)
  account_type   String         @db.VarChar(50)
  account_number String?        @db.VarChar(100)
  balance        Decimal?       @default(0.00) @db.Decimal(14, 2)
  deleted_at     DateTime?      @db.Timestamp(6)
  deleted_by     Int?
  transactions   transactions[]
}

model ip_rules {
  id               Int       @id @default(autoincrement())
  ip_address       String    @unique @db.VarChar(50)
  rule_type        String    @default("block") @db.VarChar(20)
  reason           String?   @db.VarChar(255)
  blocked_attempts Int?      @default(0)
  created_by       Int?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users?    @relation(fields: [created_by], references: [id], onUpdate: NoAction)
}

model menu_items {
  id             Int              @id @default(autoincrement())
  label          String           @db.VarChar(80)
  slug           String           @unique @db.VarChar(80)
  icon           String           @db.VarChar(40)
  route_key      String           @db.VarChar(80)
  sort_order     Int              @default(0)
  is_active      Boolean          @default(true)
  menu_sub_items menu_sub_items[]

  @@index([sort_order], map: "idx_menu_items_sort")
}

model menu_sub_items {
  id           Int        @id @default(autoincrement())
  menu_item_id Int
  label        String     @db.VarChar(120)
  route_key    String     @db.VarChar(80)
  sort_order   Int        @default(0)
  menu_items   menu_items @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_menu_sub_items_parent")

  @@unique([menu_item_id, label])
  @@index([menu_item_id, sort_order], map: "idx_menu_sub_items_parent")
}

model models {
  id              Int             @id @default(autoincrement())
  name            String          @db.VarChar(100)
  brand_id        Int
  category_id     Int?
  sub_category_id Int?
  deleted_at      DateTime?       @db.Timestamp(6)
  deleted_by      Int?
  brands          brands          @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_models_brand")
  categories      categories?     @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_models_category")
  sub_categories  sub_categories? @relation(fields: [sub_category_id], references: [id], onUpdate: NoAction, map: "fk_models_sub_category")
  products        products[]

  @@unique([name, brand_id])
}

model password_reset_requests {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  user_name     String?   @db.VarChar(200)
  identifier    String    @db.VarChar(200)
  user_type     String    @db.VarChar(50)
  target_role   String    @db.VarChar(50)
  contact_phone String?   @db.VarChar(50)
  shop_name     String?   @db.VarChar(200)
  reason        String?
  status        String?   @default("pending") @db.VarChar(50)
  temp_password String?   @db.VarChar(100)
  resolved_by   String?   @db.VarChar(100)
  resolved_at   DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([target_role, status], map: "idx_reset_req_target_status")
}

model payment_accounts {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique @db.VarChar(100)
  account_type            String                    @default("drawer") @db.VarChar(30)
  balance                 Decimal                   @default(0) @db.Decimal(14, 2)
  is_active               Boolean?                  @default(true)
  deleted_at              DateTime?                 @db.Timestamp(6)
  account_number          String?                   @db.VarChar(100)
  tender_id               Int?
  account_transactions    account_transactions[]
  expenses                expenses[]
  tenders                 Tender?                   @relation(fields: [tender_id], references: [id], onUpdate: NoAction)
  purchase_order_payments purchase_order_payments[]
}

model payment_methods {
  id                      Int                       @id @default(autoincrement())
  method_name             String                    @unique @db.VarChar(100)
  is_active               Boolean?                  @default(true)
  account_details         String?
  deleted_at              DateTime?                 @db.Timestamp(6)
  deleted_by              Int?
  name                    String?                   @db.VarChar(100)
  type                    String?                   @default("cash") @db.VarChar(50)
  account_number          String?                   @db.VarChar(100)
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(6)
  purchase_order_payments purchase_order_payments[]
  purchase_orders         purchase_orders[]
  sales                   sales[]
  transactions            transactions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id              Int              @id @default(autoincrement())
  sale_id         Int?
  purchase_id     Int?
  payment_mode    String           @db.VarChar(50)
  account_name    String?          @db.VarChar(150)
  reference_no    String?          @db.VarChar(120)
  amount          Decimal          @default(0) @db.Decimal(14, 2)
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  purchase_orders purchase_orders? @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_purchase")
  sales           sales?           @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_sale")
}

model permissions {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  module_name      String?            @db.VarChar(100)
  code             String?            @unique @db.VarChar(100)
  role_permissions role_permissions[]
}

model product_images {
  id         Int       @id @default(autoincrement())
  product_id Int
  image_url  String
  image_type String    @default("gallery") @db.VarChar(20)
  sort_order Int       @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_images_product")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model product_names {
  id              Int             @id @default(autoincrement())
  name            String          @db.VarChar(150)
  brand_id        Int?
  category_id     Int?
  sub_category_id Int?
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  deleted_at      DateTime?       @db.Timestamp(6)
  deleted_by      Int?
  brands          brands?         @relation(fields: [brand_id], references: [id], onUpdate: NoAction)
  categories      categories?     @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  sub_categories  sub_categories? @relation(fields: [sub_category_id], references: [id], onUpdate: NoAction)

  @@unique([name, brand_id])
}

model product_returns {
  id                 Int        @id @default(autoincrement())
  return_no          String     @unique @db.VarChar(50)
  order_source       String?    @default("offline") @db.VarChar(20)
  invoice_no         String?    @db.VarChar(50)
  ecommerce_order_no String?    @db.VarChar(50)
  customer_id        Int?
  product_id         Int?
  return_qty         Int
  refund_amount      Decimal?   @default(0.00) @db.Decimal(14, 2)
  return_reason      String?
  condition          String?    @default("Good") @db.VarChar(50)
  return_date        DateTime?  @default(now()) @db.Timestamp(6)
  deleted_at         DateTime?  @db.Timestamp(6)
  customer_name      String?    @db.VarChar(150)
  customer_phone     String?    @db.VarChar(50)
  product_name       String?    @db.VarChar(255)
  serial_code        String?    @db.VarChar(100)
  return_type        String?    @default("Refund") @db.VarChar(50)
  refund_method      String?    @default("Cash") @db.VarChar(50)
  deleted_by         Int?
  customers          customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products           products?  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model products {
  id                            Int                        @id @default(autoincrement())
  name                          String                     @db.VarChar(150)
  short_name                    String?                    @db.VarChar(100)
  sku                           String?                    @unique(map: "unique_product_sku") @default(dbgenerated("('SKU-'::text || lpad((nextval('product_sku_seq'::regclass))::text, 5, '0'::text))")) @db.VarChar(100)
  barcode                       String?                    @db.VarChar(100)
  description                   String?
  category_id                   Int?
  sub_category_id               Int?
  brand_id                      Int?
  model_id                      Int?
  series_id                     Int?
  purchase_price                Decimal?                   @default(0) @db.Decimal(12, 2)
  selling_price                 Decimal?                   @default(0) @db.Decimal(12, 2)
  mrp                           Decimal?                   @default(0) @db.Decimal(12, 2)
  stock                         Int?                       @default(0)
  min_stock                     Int?                       @default(0)
  purchase_count                Int                        @default(0)
  purchased_at                  DateTime?                  @db.Timestamp(6)
  location                      String?                    @db.VarChar(100)
  warranty_months               Int?                       @default(0)
  status                        String?                    @default("active") @db.VarChar(20)
  image_url                     String?
  is_featured                   Boolean?                   @default(false)
  supplier_name                 String?                    @db.VarChar(150)
  supplier_phone                String?                    @db.VarChar(50)
  created_at                    DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                  @default(now()) @db.Timestamp(6)
  deleted_at                    DateTime?                  @db.Timestamp(6)
  is_ecommerce_active           Boolean?                   @default(true)
  feature_image                 String?
  deleted_by                    Int?
  supplier_warranty_expire_date DateTime?                  @db.Date
  is_serial_tracked             Boolean?                   @default(false)
  is_serial_required            Boolean?                   @default(false)
  is_warranty_required          Boolean?                   @default(false)
  damaged_products              damaged_products[]
  ecommerce_order_items         ecommerce_order_items[]
  product_images                product_images[]
  product_returns               product_returns[]
  brands                        brands?                    @relation(fields: [brand_id], references: [id], onUpdate: NoAction, map: "fk_products_brand")
  categories                    categories?                @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_products_category")
  models                        models?                    @relation(fields: [model_id], references: [id], onUpdate: NoAction, map: "fk_products_model")
  series                        series?                    @relation(fields: [series_id], references: [id], onUpdate: NoAction, map: "fk_products_series")
  sub_categories                sub_categories?            @relation(fields: [sub_category_id], references: [id], onUpdate: NoAction, map: "fk_products_sub_category")
  purchase_order_items          purchase_order_items[]
  purchase_quotation_items      purchase_quotation_items[]
  sales_items                   sales_items[]
  sales_quotation_items         sales_quotation_items[]
  stock_levels                  stock_levels[]
  stock_transfers               stock_transfers[]
  warranty_claims               warranty_claims[]

  @@index([barcode], map: "idx_products_barcode")
  @@index([brand_id], map: "idx_products_brand_id")
  @@index([category_id], map: "idx_products_category_id")
  @@index([model_id], map: "idx_products_model_id")
  @@index([name], map: "idx_products_name")
  @@index([sku], map: "idx_products_sku")
  @@index([stock], map: "idx_products_stock")
  @@index([sub_category_id], map: "idx_products_sub_category_id")
}

model purchase_order_items {
  id                            Int                      @id @default(autoincrement())
  purchase_order_id             Int
  product_id                    Int
  quantity                      Int                      @default(0)
  cost_price                    Decimal                  @default(0) @db.Decimal(14, 2)
  sale_price                    Decimal                  @default(0) @db.Decimal(14, 2)
  margin_type                   String                   @default("percent") @db.VarChar(10)
  margin_value                  Decimal                  @default(0) @db.Decimal(14, 2)
  final_sale_price              Decimal                  @default(0) @db.Decimal(14, 2)
  line_total                    Decimal                  @default(0) @db.Decimal(14, 2)
  expected_date                 DateTime?                @db.Date
  warranty_months               Int?                     @default(0)
  sort_order                    Int                      @default(0)
  supplier_warranty_expire_date DateTime?                @db.Date
  updated_at                    DateTime?                @db.Timestamp(6)
  supplier_warranty_months      Int?
  customer_warranty_months      Int?
  purchase_orders               purchase_orders          @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_po_items_order")
  products                      products                 @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_po_items_product")
  purchase_order_serials        purchase_order_serials[]

  @@index([purchase_order_id], map: "idx_purchase_order_items_order")
  @@index([purchase_order_id], map: "idx_purchase_order_items_po_id")
  @@index([product_id], map: "idx_purchase_order_items_product_id")
}

model purchase_order_payments {
  id                Int               @id @default(autoincrement())
  purchase_order_id Int
  payment_method    String            @db.VarChar(40)
  account_id        Int?
  amount            Decimal           @default(0) @db.Decimal(14, 2)
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  receiver_name     String?           @db.VarChar(150)
  transaction_id    String?           @db.VarChar(100)
  sub_option        String?           @db.VarChar(150)
  payment_method_id Int?
  payment_accounts  payment_accounts? @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_po_payments_account")
  purchase_orders   purchase_orders   @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_po_payments_order")
  payment_methods   payment_methods?  @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([purchase_order_id], map: "idx_purchase_order_payments_order")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model purchase_order_serials {
  id                     Int                  @id @default(autoincrement())
  purchase_order_item_id Int
  serial_code            String               @unique @db.VarChar(120)
  purchase_order_items   purchase_order_items @relation(fields: [purchase_order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_po_serials_item")
}

model purchase_orders {
  id                      Int                       @id @default(autoincrement())
  po_number               String                    @unique @db.VarChar(30)
  supplier_id             Int
  transaction_reference   String?                   @db.VarChar(120)
  extra_cost              Decimal                   @default(0) @db.Decimal(14, 2)
  total_cost              Decimal                   @default(0) @db.Decimal(14, 2)
  total_sale              Decimal                   @default(0) @db.Decimal(14, 2)
  potential_profit        Decimal                   @default(0) @db.Decimal(14, 2)
